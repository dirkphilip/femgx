{
  "name": "femgx",
  "version": "0.1.0",
  "description": "A TypeScript graphics library rendering finite element models with WebGPU and GPU instancing",
  "keywords": [
    "webgpu",
    "finite-element",
    "fem",
    "3d",
    "graphics",
    "instancing"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/femgx.cjs",
  "module": "./dist/femgx.js",
  "types": "./dist/entries/root.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/entries/root.d.ts",
        "default": "./dist/femgx.js"
      },
      "require": {
        "types": "./dist/cjs/entries/root.d.cts",
        "default": "./dist/femgx.cjs"
      }
    },
    "./model": {
      "import": {
        "types": "./dist/model.d.ts",
        "default": "./dist/model.js"
      },
      "require": {
        "types": "./dist/cjs/model.d.cts",
        "default": "./dist/model.cjs"
      }
    },
    "./io": {
      "import": {
        "types": "./dist/io.d.ts",
        "default": "./dist/io.js"
      },
      "require": {
        "types": "./dist/cjs/io.d.cts",
        "default": "./dist/io.cjs"
      }
    },
    "./io/glb": {
      "import": {
        "types": "./dist/io/glb.d.ts",
        "default": "./dist/io/glb.js"
      },
      "require": {
        "types": "./dist/cjs/io/glb.d.cts",
        "default": "./dist/io/glb.cjs"
      }
    },
    "./camera": {
      "import": {
        "types": "./dist/camera.d.ts",
        "default": "./dist/camera.js"
      },
      "require": {
        "types": "./dist/cjs/camera.d.cts",
        "default": "./dist/camera.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/cjs/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./platform": {
      "import": {
        "types": "./dist/platform.d.ts",
        "default": "./dist/platform.js"
      },
      "require": {
        "types": "./dist/cjs/platform.d.cts",
        "default": "./dist/platform.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "test:package": "node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run test:package",
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --config vite.demo.config.ts",
    "build:docs": "typedoc",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:actions && npm run lint:demo-boundary && npm run lint:demo-size && npm run lint:public-docs && eslint . --max-warnings 0 && npm run lint:dependencies",
    "lint:fix": "npm run lint:actions && npm run lint:demo-boundary && npm run lint:demo-size && eslint . --fix && npm run lint:dependencies",
    "lint:actions": "node scripts/check-github-actions.mjs",
    "lint:actionlint": "node scripts/actionlint.mjs",
    "lint:demo-boundary": "node scripts/check-demo-import-boundary.mjs",
    "lint:demo-size": "node scripts/check-demo-size.mjs",
    "lint:public-docs": "node scripts/check-public-entry-docs.mjs",
    "lint:dependencies": "depcruise src --config .dependency-cruiser.mjs",
    "review:diff": "node scripts/review-diff.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:core": "vitest run --exclude 'test/demo/**' --exclude 'test/renderer/**' --exclude 'test/viewport/**' --exclude 'test/platform/**' --exclude 'test/scripts/**' --exclude 'test/bench/**'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:demo:coverage": "npm run test:demo:coverage:core && npm run test:demo:coverage:components",
    "test:demo:coverage:core": "vitest run --config vitest.demo.core.config.ts --coverage",
    "test:demo:coverage:components": "vitest run --config vitest.demo.components.config.ts --coverage",
    "bench": "vitest bench",
    "bench:budget": "vitest run --config vitest.budget.config.ts",
    "bench:webgpu": "npm run test:e2e:performance",
    "test:e2e": "npm run test:e2e:combined",
    "test:e2e:core": "playwright test --project=chrome e2e/core",
    "test:e2e:demo": "playwright test --project=chrome e2e/demo",
    "test:e2e:combined": "playwright test --project=chrome --workers=1",
    "test:e2e:layout": "playwright test --project=chrome e2e/demo/demo-layout.spec.ts",
    "test:e2e:software": "playwright test --project=chrome-software --project=chrome-software-interaction --project=chrome-software-rendering",
    "test:e2e:performance": "RUN_PERF=1 playwright test --project=chrome e2e/demo/perf.spec.ts",
    "test:e2e:no-gpu": "playwright test --project=chrome-unsupported e2e/core/core-foundation.spec.ts -g \"reports typed unsupported\"",
    "test:e2e:ci": "npm run test:e2e:no-gpu",
    "test:e2e:install": "playwright install chrome",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "dependency-cruiser": "^18.2.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-svelte": "^3.23.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typedoc": "0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "wgsl_reflect": "^1.5.0"
  }
}
