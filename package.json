{
  "name": "femgx",
  "version": "0.1.0",
  "description": "A TypeScript graphics library rendering giant finite element models with WebGPU and GPU instancing",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/femgx.umd.cjs",
  "module": "./dist/femgx.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/femgx.js",
      "require": "./dist/femgx.umd.cjs"
    }
  },
  "scripts": {
    "check-node": "node scripts/check-node-version.mjs",
    "preinstall": "npm run check-node",
    "predev": "npm run check-node",
    "prebuild": "npm run check-node",
    "pretypecheck": "npm run check-node",
    "prelint": "npm run check-node",
    "prelint:fix": "npm run check-node",
    "preformat": "npm run check-node",
    "preformat:check": "npm run check-node",
    "pretest": "npm run check-node",
    "pretest:watch": "npm run check-node",
    "pretest:coverage": "npm run check-node",
    "prebench": "npm run check-node",
    "prebench:budget": "npm run check-node",
    "pretest:e2e": "npm run check-node",
    "pretest:e2e:install": "npm run check-node",
    "prepreview": "npm run check-node",
    "prepre-commit": "npm run check-node",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test demo e2e --max-warnings 0",
    "lint:fix": "eslint src test demo e2e --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:budget": "vitest run --config vitest.budget.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
