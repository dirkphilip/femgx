{
  "name": "femgx",
  "version": "0.1.0",
  "description": "A TypeScript graphics library rendering finite element models with WebGPU and GPU instancing",
  "keywords": [
    "webgpu",
    "finite-element",
    "fem",
    "3d",
    "graphics",
    "instancing"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/femgx.js",
  "types": "./dist/entries/root.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entries/root.d.ts",
      "default": "./dist/femgx.js"
    },
    "./model": {
      "types": "./dist/entries/model.d.ts",
      "default": "./dist/model.js"
    },
    "./io": {
      "types": "./dist/entries/io.d.ts",
      "default": "./dist/io.js"
    },
    "./io/glb": {
      "types": "./dist/entries/io/glb.d.ts",
      "default": "./dist/io/glb.js"
    },
    "./camera": {
      "types": "./dist/entries/camera.d.ts",
      "default": "./dist/camera.js"
    },
    "./interaction": {
      "types": "./dist/entries/interaction.d.ts",
      "default": "./dist/interaction.js"
    },
    "./results": {
      "types": "./dist/entries/results.d.ts",
      "default": "./dist/results.js"
    },
    "./runtime": {
      "types": "./dist/entries/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./platform": {
      "types": "./dist/entries/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "test:package": "node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run test:package",
    "dev": "vite --config config/vite.demo.config.ts",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --config config/vite.demo.config.ts",
    "build:docs": "typedoc --options config/typedoc.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck:ts": "tsc --noEmit",
    "typecheck": "npm run typecheck:ts && npm run check:svelte",
    "lint": "npm run lint:actions && npm run lint:demo-boundary && npm run lint:demo-size && npm run lint:folder-structure && npm run lint:public-docs && npm run lint:markdown && npm run lint:styles && npm run lint:wgsl && eslint . --max-warnings 0 && npm run lint:dependencies && npm run lint:dead-code",
    "lint:fix": "npm run lint:actions && npm run lint:demo-boundary && npm run lint:demo-size && npm run lint:folder-structure && eslint . --fix && npm run lint:dependencies && npm run lint:dead-code",
    "lint:actions": "node scripts/check-github-actions.mjs",
    "lint:actionlint": "node scripts/actionlint.mjs",
    "lint:demo-boundary": "node scripts/check-demo-import-boundary.mjs",
    "lint:demo-size": "node scripts/check-demo-size.mjs",
    "lint:folder-structure": "node scripts/check-folder-structure.mjs",
    "lint:public-docs": "node scripts/check-public-entry-docs.mjs",
    "lint:markdown": "node scripts/check-markdown-links.mjs",
    "lint:styles": "stylelint \"**/*.{css,svelte}\" --allow-empty-input",
    "lint:wgsl": "vitest run test/scripts/wgsl-validation.test.ts --reporter=dot",
    "lint:package": "npm run build && publint run --strict --pack=false",
    "lint:dependencies": "depcruise src --config config/dependency-cruiser.mjs",
    "lint:dead-code": "knip --include files,dependencies,unlisted,unresolved,binaries",
    "review:diff": "node scripts/review-diff.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:core": "vitest run --exclude 'test/demo/**' --exclude 'test/renderer/**' --exclude 'test/viewport/**' --exclude 'test/platform/**' --exclude 'test/scripts/**' --exclude 'test/bench/**'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:demo:coverage": "npm run test:demo:coverage:core && npm run test:demo:coverage:components",
    "test:demo:coverage:core": "vitest run --config config/vitest.demo.core.config.ts --coverage",
    "test:demo:coverage:components": "vitest run --config config/vitest.demo.components.config.ts --coverage",
    "bench": "vitest bench",
    "bench:budget": "vitest run --config config/vitest.budget.config.ts",
    "bench:operations": "vitest run --config config/vitest.operations.config.ts",
    "bench:scaling:large": "vitest run --config config/vitest.large-scaling.config.ts",
    "bench:selection-sync": "vitest run --config config/vitest.selection-sync.config.ts",
    "bench:node-selection-sync": "vitest run --config config/vitest.node-selection-sync.config.ts",
    "bench:tet4-visibility-sync": "vitest run --config config/vitest.tet4-visibility-sync.config.ts",
    "bench:affected-part-sync": "vitest run --config config/vitest.affected-part-sync.config.ts",
    "bench:cold-attachment": "vitest run --config config/vitest.cold-attachment.config.ts",
    "bench:webgpu": "npm run test:e2e:performance",
    "bench:webgpu:glb": "RUN_GLB_VIEWPORT_PERF=1 playwright test --project=chrome e2e/demo/perf-glb-{viewport,file-open}.spec.ts",
    "test:e2e": "npm run test:e2e:combined",
    "test:e2e:core": "playwright test --project=chrome e2e/core",
    "test:e2e:demo": "playwright test --project=chrome e2e/demo",
    "test:e2e:combined": "playwright test --project=chrome --workers=1",
    "test:e2e:layout": "playwright test --project=chrome e2e/demo/demo-layout.spec.ts",
    "test:e2e:software": "playwright test --project=chrome-software --project=chrome-software-interaction",
    "test:e2e:performance": "RUN_PERF=1 playwright test --project=chrome e2e/demo/perf.spec.ts",
    "test:e2e:no-gpu": "playwright test --project=chrome-unsupported e2e/core/core-foundation.spec.ts -g \"reports typed unsupported\"",
    "test:e2e:ci": "npm run test:e2e:no-gpu",
    "test:e2e:install": "playwright install chrome",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,svelte}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,html,css,scss,svelte}": [
      "prettier --write"
    ]
  },
  "knip": {
    "entry": [
      "e2e/core/core-host.ts"
    ],
    "ignore": [
      "scripts/*.d.mts"
    ],
    "ignoreDependencies": [
      "@arethetypeswrong/cli"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "dependency-cruiser": "^18.2.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "naga-wasi-cli": "^0.1.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.23",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typedoc": "0.28.20",
    "typescript": "^6.0.3",
    "typescript-5": "npm:typescript@5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "wgsl_reflect": "^1.5.0"
  }
}
